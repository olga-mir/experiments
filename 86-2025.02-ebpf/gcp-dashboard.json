{
  "displayName": "GKE eBPF",
  "dashboardFilters": [
    {
      "filterType": "METRIC_LABEL",
      "labelKey": "pod",
      "stringValue": "",
      "templateVariable": "ebpf_node",
      "valueType": "STRING"
    },
    {
      "filterType": "METRIC_LABEL",
      "labelKey": "cgroup",
      "stringValue": "",
      "templateVariable": "cgroup_pod",
      "valueType": "STRING"
    }
  ],
  "description": "",
  "labels": {},
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Custom eBPF GKE Dashboard",
          "collapsibleGroup": {
            "collapsed": false
          },
          "id": ""
        }
      },
      {
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Description",
          "id": "",
          "text": {
            "content": "This dashboard is an implementation of https://netflixtechblog.com/noisy-neighbor-detection-with-ebpf-64b1f4b3bbdd\n\n**Required filters (top of page):**\n- **ebpf_node** — select one eBPF DaemonSet pod (= one node). Cardinality is per-node; mixing nodes makes the graphs unreadable.\n- **cgroup_pod** — (Noisy Neighbour section only) select the victim pod to investigate.",
            "format": "MARKDOWN",
            "style": {
              "backgroundColor": "#FFFFFF",
              "fontSize": "FS_LARGE",
              "horizontalAlignment": "H_LEFT",
              "padding": "P_EXTRA_SMALL",
              "pointerLocation": "POINTER_LOCATION_UNSPECIFIED",
              "textColor": "#212121",
              "verticalAlignment": "V_TOP"
            }
          }
        }
      },
      {
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "eBPF Events Ingested",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": false
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(ebpf_events_total[1m]))",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "events/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 16,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "ebpf_runq_latency_nanoseconds_bucket",
          "collapsibleGroup": {
            "collapsed": false
          },
          "id": ""
        }
      },
      {
        "yPos": 16,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "p99 (logarithmic scale)",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (cgroup, prev_cgroup, le, ${__groupby}) (rate(ebpf_runq_latency_nanoseconds_bucket{pod=~\"${ebpf_node.value}\", cgroup=~\"pod/.*\"}[5m]))) / 1e6"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "latency (ms)",
              "scale": "LOG10"
            }
          }
        }
      },
      {
        "yPos": 16,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "p50",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": false
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (cgroup, prev_cgroup, le, ${__groupby}) (rate(ebpf_runq_latency_nanoseconds_bucket{pod=~\"${ebpf_node.value}\", cgroup=~\"pod/.*\"}[5m]))) / 1e6",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "latency (ms)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 32,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "p99 latency in milliseconds, grouped by cgroup pair",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": false
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(\n  0.99,\n  sum by (cgroup, prev_cgroup, le, ${__groupby}) (\n    rate(ebpf_runq_latency_nanoseconds_bucket{pod=~\"${ebpf_node.value}\", cgroup=~\"pod/.*\"}[5m])\n  )\n) / 1e6",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "latency (ms)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 32,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "overall node-level p99",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": false
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(\n  0.99,\n  sum by (le, ${__groupby}) (\n    rate(ebpf_runq_latency_nanoseconds_bucket{pod=~\"${ebpf_node.value}\", cgroup=~\"pod/.*\"}[5m])\n  )\n) / 1e6",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "latency (ms)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 48,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Noisy Neighbour Analysis",
          "collapsibleGroup": {
            "collapsed": false
          },
          "id": ""
        }
      },
      {
        "yPos": 48,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Noisy neighbours for selected pod — p99 latency & event rate by prev_cgroup",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(ebpf_runq_latency_nanoseconds_bucket{pod=~\"${ebpf_node.value}\", cgroup=~\"${cgroup_pod.value}\"}[2m])) by (cgroup, prev_cgroup)",
                  "unitOverride": ""
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(\n  0.99,\n  sum by (prev_cgroup, le) (\n    rate(ebpf_runq_latency_nanoseconds_bucket{pod=~\"${ebpf_node.value}\", cgroup=~\"${cgroup_pod.value}\"}[5m])\n  )\n) / 1e6",
                  "unitOverride": "ms"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "latency / event rate",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
