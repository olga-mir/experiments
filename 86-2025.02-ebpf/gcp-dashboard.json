            "dataSets": [
              {
                "breakdowns": [],
                "dimensions": [],
                "legendTemplate": "",
                "measures": [],
                "plotType": "LINE",
                "sort": [],
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "outputFullDuration": false,
                  "prometheusQuery": "histogram_quantile(0.50, sum by (cgroup, prev_cgroup, le, ${__groupby}) (rate(ebpf_runq_latency_nanoseconds_bucket[5m]))) / 1e6",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 32,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "p99 latency in milliseconds, grouped by cgroup pair",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": false
            },
            "dataSets": [
              {
                "breakdowns": [],
                "dimensions": [],
                "legendTemplate": "",
                "measures": [],
                "plotType": "LINE",
                "sort": [],
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "outputFullDuration": false,
                  "prometheusQuery": "  histogram_quantile(\n    0.99,\n    sum by (cgroup, prev_cgroup, le,  ${__groupby}) (\n      rate(ebpf_runq_latency_nanoseconds_bucket[5m])\n    )\n  ) / 1e6",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 48,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Noisy Neighbour Analysis",
          "collapsibleGroup": {
            "collapsed": false
          }
        }
      },
      {
        "yPos": 48,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Noisy neighbours for selected pod — p99 latency by prev_cgroup (ms)",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": true
            },
            "dataSets": [
              {
                "breakdowns": [],
                "dimensions": [],
                "legendTemplate": "",
                "measures": [],
                "plotType": "LINE",
                "sort": [],
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "outputFullDuration": false,
                  "prometheusQuery": "histogram_quantile(\n  0.99,\n  sum by (prev_cgroup, le) (\n    rate(ebpf_runq_latency_nanoseconds_bucket{cgroup=~\"${cgroup_pod.value}\"}[5m])\n  )\n) / 1e6",
                  "unitOverride": "ms"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "latency (ms)",
              "scale": "LINEAR"
            }
          }
        }
      },
