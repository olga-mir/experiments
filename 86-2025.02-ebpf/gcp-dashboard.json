{
  "displayName": "GKE eBPF Noisy Neighbor",
  "dashboardFilters": [
    {
      "filterType": "METRIC_LABEL",
      "labelKey": "cgroup",
      "stringValue": "",
      "templateVariable": "cgroup_pod",
      "valueType": "STRING"
    }
  ],
  "description": "eBPF Noisy Neighbor Run-Queue Latency Dashboard based on Netflix Tech Blog",
  "labels": {},
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Custom eBPF GKE Dashboard",
          "collapsibleGroup": {
            "collapsed": false
          },
          "id": ""
        }
      },
      {
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Description",
          "id": "",
          "text": {
            "content": "This dashboard is an implementation of https://netflixtechblog.com/noisy-neighbor-detection-with-ebpf-64b1f4b3bbdd\n\n**Usage:**\n- **eBPF Events Ingested**: Shows scheduling delay events exceeding 1ms.\n- **p99 Run-Queue Latency**: 99th percentile CPU queue delay.\n- **cgroup_pod Filter**: Select target victim pod to analyze preemption source (`prev_cgroup`).",
            "format": "MARKDOWN",
            "style": {
              "backgroundColor": "#FFFFFF",
              "fontSize": "FS_LARGE",
              "horizontalAlignment": "H_LEFT",
              "padding": "P_EXTRA_SMALL",
              "pointerLocation": "POINTER_LOCATION_UNSPECIFIED",
              "textColor": "#212121",
              "verticalAlignment": "V_TOP"
            }
          }
        }
      },
      {
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "eBPF Events Ingested",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": false
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(ebpf_events_total[1m]))",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "events/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 16,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Run-Queue Latency Metrics",
          "collapsibleGroup": {
            "collapsed": false
          },
          "id": ""
        }
      },
      {
        "yPos": 16,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Overall p99 Run-Queue Latency by Victim Pod (ms)",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum(rate(ebpf_runq_latency_nanoseconds_bucket[2m])) by (le, cgroup)) / 1000000"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "latency (ms)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 16,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "p50 Run-Queue Latency by Victim Pod (ms)",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": false
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum(rate(ebpf_runq_latency_nanoseconds_bucket[2m])) by (le, cgroup)) / 1000000",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "latency (ms)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 32,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Noisy Neighbor Analysis",
          "collapsibleGroup": {
            "collapsed": false
          },
          "id": ""
        }
      },
      {
        "yPos": 32,
        "height": 16,
        "width": 48,
        "widget": {
          "title": "Identify Noisy Neighbor (prev_cgroup Attributed Latency Rate)",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(ebpf_runq_latency_nanoseconds_bucket{cgroup=~\"pod/.*\"}[2m])) by (cgroup, prev_cgroup)",
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "event rate",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}
