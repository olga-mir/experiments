# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Optional. Agent Runtime deploy region (Taskfile default us-central1).
# GOOGLE_CLOUD_REGION=us-central1

# Prompt/response collection for Agent Platform traces and offline evals.
# https://docs.cloud.google.com/gemini-enterprise-agent-platform/optimize/evaluation/evaluate-offline#telemetry_requirements
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# Set by `task telemetry:bucket` (do not commit the real bucket name).
# LOGS_BUCKET_NAME=your-gcp-project-id-ping-aic-explainer-logs
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://your-gcp-project-id-ping-aic-explainer-logs/completions

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
